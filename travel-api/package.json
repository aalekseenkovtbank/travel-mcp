{
  "name": "travel-nova-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend service for the Travel Nova assistant",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca tsx watch src/server.ts",  
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_OPTIONS=--use-system-ca node dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@travel-growth-inspiration/contracts": "0.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "openai": "^6.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
