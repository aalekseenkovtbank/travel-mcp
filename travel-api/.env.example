NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/travel-nova.sqlite
TBANK_MCP_COMMAND=../tbank-mcp/bin/tbank-mcp
# TBANK_SESSION_PATH=/absolute/path/to/session.json
DATA_MODE=live
# Секрет можно задать здесь или в отдельном игнорируемом файле config.env.
# LLM_PROXY_API_KEY=
LLM_PROXY_BASE_URL=https://llm-proxy.t-tech.team/v1
LLM_PROXY_MODEL=tgpt/text.instant.medium
TWOGIS_API_KEY=
TWOGIS_PLACES_URL=https://catalog.api.2gis.com/3.0/items
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
PROVIDER_TIMEOUT_MS=15000
HOTEL_PROVIDER_TIMEOUT_MS=35000
FLIGHT_PROVIDER_TIMEOUT_MS=45000
MCP_MAX_CONCURRENCY=3
MCP_FLIGHT_MAX_CONCURRENCY=6
MCP_HOTEL_MAX_CONCURRENCY=3
